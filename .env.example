# ¿LLM local (Ollama) o API comercial?
#   true  → levanta contenedor `ollama` + `ollama-init` (auto-pull del modelo).
#           Requiere ~5 GB de espacio en disco y descarga el modelo la primera vez.
#   false → no levanta Ollama; usa el backend remoto que indique MODEL_BACKEND
#           (anthropic:..., openai:..., etc.) con su API key correspondiente.
# El Makefile (targets up/down/logs) traduce esto a --profile ollama de Docker.
MODEL_LOCAL=true

# Backend de modelos (LiteLLM)
# Formatos válidos: ollama:qwen2.5:14b | ollama:llama3.1:8b | anthropic:claude-opus-4 | openai:gpt-4o
# Con MODEL_LOCAL=false, este valor debe ser uno remoto (anthropic:* / openai:*).
MODEL_BACKEND=ollama:qwen2.5:7b

# URL base de Ollama dentro de la red de Docker (servicio del compose).
# Si usas Ollama nativo en tu Mac (fuera de Docker), cambia a:
#   OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_API_BASE=http://ollama:11434

# Persistencia (SQLite local)
DATABASE_URL=sqlite:////app/data/pasaporteabierto.db

# Langfuse self-hosted (las claves se generan en su UI tras el primer login)
LANGFUSE_HOST=http://langfuse:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Secretos de Langfuse self-hosted (cambia en producción)
LANGFUSE_NEXTAUTH_SECRET=changeme-langfuse-secret
LANGFUSE_SALT=changeme-langfuse-salt

# APIs comerciales opcionales (descomenta sólo si MODEL_BACKEND las usa)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Modo demo: activa los endpoints /api/v1/demo/* en backend y los botones
# "Cargar ejemplo" en el wizard (espejado a NEXT_PUBLIC_DEMO_MODE en frontend).
# Útil para enseñar el flujo sin teclear los 47 campos del BOM ni subir PDFs.
# En producción → false.
DEMO_MODE=false

# --- Autenticación (ADR-0004) -----------------------------------------------
# Login propio: email + contraseña (hash scrypt), sesión server-side en SQLite
# y token en cookie httpOnly. No es OAuth ni multi-tenant.
#
# AUTH_COOKIE_SECURE: la cookie solo se manda por HTTPS si es true. Déjalo en
# false SOLO en dev local (http://localhost); en cualquier despliegue tras
# HTTPS ponlo a true (si no, la cookie de sesión viajaría por HTTP).
AUTH_COOKIE_SECURE=false
# SameSite de la cookie. "lax" basta si front y back son same-site (mismo
# dominio/host, distinto puerto). Tras dominios distintos usa "none" (que
# además exige AUTH_COOKIE_SECURE=true).
AUTH_COOKIE_SAMESITE=lax
# Nombre de la cookie. Si lo cambias, ajusta también NEXT_PUBLIC_AUTH_COOKIE_NAME
# en el frontend (build arg) para que el proxy de Next la reconozca.
AUTH_COOKIE_NAME=pa_session
# Vida de la sesión en días.
AUTH_SESSION_TTL_DAYS=30
# Permitir alta de cuentas (self-service). Tras dar de alta a los operarios del
# fabricante puedes ponerlo a false para cerrar el registro.
ALLOW_REGISTRATION=true
